{
  "name": "cabinet-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:preview": "tsc --noEmit && vite build --mode singlefile && node scripts/strip-shell.mjs",
    "test": "esbuild scripts/check-model.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/check-model.mjs && node node_modules/.cache/check-model.mjs",
    "rehearsal": "esbuild scripts/rehearsal.ts --bundle --platform=node --format=esm --external:playwright --log-level=warning --outfile=node_modules/.cache/rehearsal.mjs && NODE_PATH=${NODE_PATH:-/opt/node22/lib/node_modules} node node_modules/.cache/rehearsal.mjs",
    "build:portal": "esbuild portal/src/worker.ts --bundle --format=esm --platform=neutral --target=es2022 --outfile=portal/portal-worker.js --log-level=warning",
    "check:portal": "tsc --strict --noUnusedLocals --noEmit --target es2022 --moduleResolution bundler --module esnext --lib es2022,dom --skipLibCheck portal/src/worker.ts"
  },
  "dependencies": {
    "@react-three/drei": "9.114.0",
    "@react-three/fiber": "8.17.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "4.3.3",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vite-plugin-singlefile": "2.0.3"
  }
}
